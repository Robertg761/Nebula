<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Platform theme, not MaterialComponents/AppCompat: every activity is a
       ComponentActivity rendering Compose, so the only thing the XML theme has
       to get right is the window background before the first frame. It is
       Nebula's own near-black rather than @android:color/black, because the
       first frame paints #06060F and the difference between the two is a
       visible flash on a panel that has just come up to full brightness.
       Colors live in tv/ui/theme/Theme.kt. -->
  <style name="Theme.Nebula" parent="@android:style/Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/nebula_void</item>
    <item name="android:dialogTheme">@style/Theme.Nebula.Dialog</item>
  </style>

  <style name="Theme.Nebula.NoActionBar" parent="Theme.Nebula" />

  <!-- Compose's Dialog resolves android:dialogTheme for its window dim, and the platform default
       is 0.6 of pure #000. Over a wall of posters that left the artwork clearly legible behind a
       near-black sheet whose only edge is a 1dp hairline, which is why both dialogs carried a
       comment saying the hairline was the sole thing separating them from the page. 0.82 makes
       the sheet the subject. -->
  <style name="Theme.Nebula.Dialog" parent="@android:style/Theme.Material.Dialog">
    <item name="android:backgroundDimAmount">0.82</item>
  </style>
</resources>
