<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Platform theme, not MaterialComponents/AppCompat: every activity is a
       ComponentActivity rendering Compose, so the only thing the XML theme has
       to get right is a black window background (no white flash before the
       first frame). Colors live in tv/ui/theme/Theme.kt. -->
  <style name="Theme.StremioShell" parent="@android:style/Theme.Material.NoActionBar">
    <item name="android:windowBackground">@android:color/black</item>
  </style>

  <style name="Theme.StremioShell.NoActionBar" parent="Theme.StremioShell" />
</resources>
