<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon silhouette. The system recolours this to whatever the wallpaper palette says, so it has
  to be one flat shape - the gradients that make the real mark work would be tinted flat anyway, and
  the ring's front/back overlap would vanish once every pass is the same colour. Hence a heavier
  stroke and a full ellipse: at a single tone the mark has to survive on outline alone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
  android:width="108dp"
  android:height="108dp"
  android:viewportWidth="108"
  android:viewportHeight="108">
  <group
    android:pivotX="54"
    android:pivotY="54"
    android:rotation="-22">
    <path
      android:pathData="M28,54 A26,9.5 0 1 0 80,54 A26,9.5 0 1 0 28,54 Z"
      android:strokeWidth="4.5"
      android:strokeColor="#FFFFFF"
      android:fillColor="#00000000" />
  </group>
  <path
    android:fillColor="#FFFFFF"
    android:pathData="M41,54 A13,13 0 1 0 67,54 A13,13 0 1 0 41,54 Z" />
</vector>
