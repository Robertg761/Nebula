<?xml version="1.0" encoding="utf-8"?>
<!--
  The Nebula mark: a ringed core, drawn in three passes so the ring reads as passing behind the orb
  rather than across it - back ring, core, then the ring's front half on top.

  The mark spans 56dp centred on the canvas. Adaptive icons only guarantee the inner 66dp survives
  masking, but sizing right up to that line made the ring graze the mask on a circular launcher, so it
  sits well inside instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:aapt="http://schemas.android.com/aapt"
  android:width="108dp"
  android:height="108dp"
  android:viewportWidth="108"
  android:viewportHeight="108">
  <group
    android:pivotX="54"
    android:pivotY="54"
    android:rotation="-22">
    <path
      android:pathData="M28,54 A26,9.5 0 1 0 80,54 A26,9.5 0 1 0 28,54 Z"
      android:strokeWidth="4"
      android:fillColor="#00000000">
      <aapt:attr name="android:strokeColor">
        <gradient
          android:type="linear"
          android:startX="28"
          android:startY="54"
          android:endX="80"
          android:endY="54"
          android:startColor="@color/nebula_cyan"
          android:endColor="@color/nebula_violet" />
      </aapt:attr>
    </path>
  </group>
  <path android:pathData="M41,54 A13,13 0 1 0 67,54 A13,13 0 1 0 41,54 Z">
    <aapt:attr name="android:fillColor">
      <gradient
        android:type="linear"
        android:startX="41"
        android:startY="41"
        android:endX="67"
        android:endY="67"
        android:startColor="@color/nebula_violet_bright"
        android:endColor="@color/nebula_cyan" />
    </aapt:attr>
  </path>
  <group
    android:pivotX="54"
    android:pivotY="54"
    android:rotation="-22">
    <path
      android:pathData="M80,54 A26,9.5 0 0 1 28,54"
      android:strokeWidth="4"
      android:strokeLineCap="round"
      android:fillColor="#00000000">
      <aapt:attr name="android:strokeColor">
        <gradient
          android:type="linear"
          android:startX="80"
          android:startY="54"
          android:endX="28"
          android:endY="54"
          android:startColor="@color/nebula_violet"
          android:endColor="@color/nebula_cyan" />
      </aapt:attr>
    </path>
  </group>
</vector>
