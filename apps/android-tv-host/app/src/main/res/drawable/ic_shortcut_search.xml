<?xml version="1.0" encoding="utf-8"?>
<!--
  The Search shortcut glyph, drawn for the launcher's long-press menu rather than for any surface
  inside the app.

  Stroked rather than filled, on the same reasoning as the launcher mark: the shortcut sheet renders
  these small, and an outline survives the scale-down where a solid silhouette turns into a blob. One
  flat accent colour because the launcher composites this over its own background, whose brightness we
  do not control - the violet reads against both the dark Google TV sheet and a light one, which a
  white or near-black glyph would not.

  The handle starts inside the ring's stroke so the two shapes read as one object at any size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
  android:width="48dp"
  android:height="48dp"
  android:viewportWidth="24"
  android:viewportHeight="24">
  <path
    android:pathData="M4,10 A6,6 0 1 0 16,10 A6,6 0 1 0 4,10 Z"
    android:strokeWidth="2"
    android:strokeColor="@color/nebula_violet"
    android:fillColor="#00000000" />
  <path
    android:pathData="M14.5,14.5 L20,20"
    android:strokeWidth="2"
    android:strokeLineCap="round"
    android:strokeColor="@color/nebula_violet"
    android:fillColor="#00000000" />
</vector>
