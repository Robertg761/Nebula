        android:type="linear"
        android:startX="0"
        android:startY="180"
        android:endX="320"
        android:endY="0"
        android:startColor="@color/nebula_void"
        android:endColor="#171040" />
    </aapt:attr>
  </path>
  <path android:pathData="M0,0h320v180h-320z">
