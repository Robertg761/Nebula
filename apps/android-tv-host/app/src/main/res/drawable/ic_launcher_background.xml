<?xml version="1.0" encoding="utf-8"?>
<!--
  Deep space, not flat black. The launcher parallaxes and scales this layer independently of the
  foreground, so it carries no detail worth losing - just a field that survives whatever shape the
  device's mask crops it to.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:aapt="http://schemas.android.com/aapt"
  android:width="108dp"
  android:height="108dp"
  android:viewportWidth="108"
  android:viewportHeight="108">
  <path android:pathData="M0,0h108v108h-108z">
    <aapt:attr name="android:fillColor">
      <gradient
        android:type="linear"
        android:startX="0"
        android:startY="0"
        android:endX="108"
        android:endY="108"
        android:startColor="#151038"
        android:endColor="@color/nebula_void" />
    </aapt:attr>
  </path>
  <!-- Bloom behind where the mark lands, so the orb looks lit rather than pasted on. -->
  <path android:pathData="M0,0h108v108h-108z">
    <aapt:attr name="android:fillColor">
      <gradient
        android:type="radial"
        android:centerX="54"
        android:centerY="54"
        android:gradientRadius="58"
        android:startColor="#598B6CFF"
        android:endColor="#008B6CFF" />
    </aapt:attr>
  </path>
</vector>
