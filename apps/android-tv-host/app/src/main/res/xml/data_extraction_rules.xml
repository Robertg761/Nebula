<?xml version="1.0" encoding="utf-8"?>
<!--
  Pairing and Settings persist TMDB and debrid-bearing addon credentials. Keep them out of both
  cloud backup and device-to-device migration even on Android 12+, where allowBackup alone does
  not fully describe transfer behavior.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude
      domain="root"
      path="." />
    <exclude
      domain="file"
      path="." />
    <exclude
      domain="database"
      path="." />
    <exclude
      domain="sharedpref"
      path="." />
    <exclude
      domain="external"
      path="." />
  </cloud-backup>
  <device-transfer>
    <exclude
      domain="root"
      path="." />
    <exclude
      domain="file"
      path="." />
    <exclude
      domain="database"
      path="." />
    <exclude
      domain="sharedpref"
      path="." />
    <exclude
      domain="external"
      path="." />
  </device-transfer>
</data-extraction-rules>
