<?xml version="1.0" encoding="utf-8"?>
<manifest
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

  <uses-feature
    android:name="android.software.leanback"
    android:required="true" />
  <uses-feature
    android:name="android.hardware.touchscreen"
    android:required="false" />
  <uses-feature
    android:name="android.hardware.faketouch"
    android:required="false" />

  <application
    android:name=".tv.StremioTvApplication"
    android:allowBackup="false"
    android:banner="@drawable/ic_tv_banner"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:fullBackupContent="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.Nebula"
    android:usesCleartextTraffic="${usesCleartextTraffic}">
    <!-- Allows physical Macrobenchmark/Perfetto runs to inspect release-like UI work without
         making the shipped application debuggable. -->
    <profileable
      android:shell="true"
      tools:targetApi="29" />
    <!-- Handles its own config changes for the same reason MpvPlayerActivity
         does: the player's refresh-rate matching can switch display mode
         mid-playback, and a compatible HDR pipeline may switch the panel's
         HDR/wide-gamut mode (colorMode), either of which otherwise recreates this activity
         behind it. The Compose back stack is saveable regardless, this just
         avoids the needless teardown of the whole UI (and its network
         state). -->
    <activity
      android:name=".tv.TvAppActivity"
      android:configChanges="colorMode|orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|navigation|uiMode"
      android:exported="true"
      android:launchMode="singleTask"
      android:theme="@style/Theme.Nebula.NoActionBar">
      <!-- Watch Next rows on the TV home carry an intent that names this
           component explicitly, so this filter is not what routes them; it is
           what makes the same URI reachable from `adb shell am start` and from
           the assistant, which is the only practical way to exercise the deep
           link without a home screen that shows the row. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data
          android:host="watch-next"
          android:scheme="stremio-tv" />
      </intent-filter>

      <!-- "Search for dune on Nebula" said to the remote. ACTION_SEARCH is the
           one the Assistant sends for an app-scoped query; the other two are what some
           Assistant surfaces and other apps still send for the same thing. All three
           carry the query in the same extra, so all three land in the same routing. -->
      <intent-filter>
        <action android:name="android.intent.action.SEARCH" />
        <action android:name="com.google.android.gms.actions.SEARCH_ACTION" />
        <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>

      <!-- Declares this as the app's searchable activity, which is what makes the
           system deliver an app-scoped voice query here rather than dropping it. -->
      <meta-data
        android:name="android.app.searchable"
        android:resource="@xml/searchable" />
    </activity>

    <!-- Handles its own config changes: matching the display refresh rate to the
         content frame rate can switch display mode mid-playback, and an HDR-capable
         device/pipeline may react to mpv's target-colorspace-hint by changing
         HDR/wide-gamut mode (colorMode). The hint is not a guarantee that a given
         TV, codec path, or Dolby Vision profile will activate HDR. Letting either recreate the
         activity would tear down mpv and restart the stream, and the color-mode
         flip can oscillate as the mode reverts on teardown.
         singleTop because MPVLib is a process-global native singleton: a second
         instance would call create() twice and libmpv exits the process. -->
    <activity
      android:name=".tv.player.MpvPlayerActivity"
      android:configChanges="colorMode|orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|navigation|uiMode"
      android:exported="false"
      android:launchMode="singleTop"
      android:screenOrientation="landscape"
      android:supportsPictureInPicture="false"
      android:theme="@style/Theme.Nebula.NoActionBar" />

    <!-- Keeps the historical launcher component name from the tv flavor so
         updates do not drop the app from TV home screens. Points at the
         native Compose app since 0.3.0. -->
    <activity-alias
      android:name=".TvLauncherActivity"
      android:enabled="true"
      android:exported="true"
      android:label="@string/app_name"
      android:targetActivity=".tv.TvAppActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
      </intent-filter>

      <!-- ShortcutService discovers static shortcuts only from a MAIN/LAUNCHER component. Keep
           the Leanback entry above for TV launchers and give the same alias the standard category
           so its android.app.shortcuts metadata is actually parsed. -->
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>

      <!-- Google TV may surface these from the long-press menu on the app icon. Nothing here
           depends on them: launchers on some TV
           versions ignore app shortcuts entirely, in which case this declaration costs a
           few bytes of manifest and changes nothing. -->
      <meta-data
        android:name="android.app.shortcuts"
        android:resource="@xml/shortcuts" />
    </activity-alias>

    <!-- The TV launcher sends this after the viewer removes one of this app's Watch Next cards.
         The receiver records that choice before deleting the provider row, so later reconciliation
         cannot put the card back. -->
    <receiver
      android:name=".tv.channel.WatchNextProgramRemovedReceiver"
      android:enabled="true"
      android:exported="true">
      <intent-filter>
        <action android:name="android.media.tv.action.WATCH_NEXT_PROGRAM_BROWSABLE_DISABLED" />
      </intent-filter>
    </receiver>

    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>

    <!-- WorkManager's auto-initializer runs from a ContentProvider, which the system
         creates before Application.onCreate. That opens the Room WorkDatabase on the
         main thread on the cold-start critical path, for work this app only ever needs
         later. Removing just that initializer leaves androidx.startup itself intact for
         any other library that registers one. StremioTvApplication implements
         androidx.work.Configuration.Provider, so WorkManager initializes on first
         getInstance() instead - dropping this without that provider would make every
         WorkManager call throw. -->
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="androidx.work.WorkManagerInitializer"
        tools:node="remove" />
    </provider>
  </application>

</manifest>
