<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

  <uses-feature
    android:name="android.software.leanback"
    android:required="true" />
  <uses-feature
    android:name="android.hardware.touchscreen"
    android:required="false" />
  <uses-feature
    android:name="android.hardware.faketouch"
    android:required="false" />

  <application
    android:name=".tv.StremioTvApplication"
    android:allowBackup="true"
    android:banner="@drawable/ic_tv_banner"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.StremioShell"
    android:usesCleartextTraffic="${usesCleartextTraffic}">
    <!-- Handles its own config changes for the same reason MpvPlayerActivity
         does: the player's refresh-rate matching can switch display mode
         mid-playback, and HDR10 content flips the panel into HDR/wide-gamut
         mode (colorMode), either of which otherwise recreates this activity
         behind it. The Compose back stack is saveable regardless, this just
         avoids the needless teardown of the whole UI (and its network
         state). -->
    <activity
      android:name=".tv.TvAppActivity"
      android:configChanges="colorMode|orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|navigation|uiMode"
      android:exported="true"
      android:launchMode="singleTask"
      android:theme="@style/Theme.StremioShell.NoActionBar" />

    <!-- Handles its own config changes: matching the display refresh rate to the
         content frame rate can switch display mode mid-playback, and mpv's
         target-colorspace-hint puts the panel into HDR/wide-gamut mode a few
         seconds into HDR10 content (colorMode). Letting either recreate the
         activity would tear down mpv and restart the stream, and the color-mode
         flip can oscillate as the mode reverts on teardown.
         singleTop because MPVLib is a process-global native singleton: a second
         instance would call create() twice and libmpv exits the process. -->
    <activity
      android:name=".tv.player.MpvPlayerActivity"
      android:configChanges="colorMode|orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|navigation|uiMode"
      android:exported="false"
      android:launchMode="singleTop"
      android:screenOrientation="landscape"
      android:supportsPictureInPicture="false"
      android:theme="@style/Theme.StremioShell.NoActionBar" />

    <!-- Keeps the historical launcher component name from the tv flavor so
         updates do not drop the app from TV home screens. Points at the
         native Compose app since 0.3.0. -->
    <activity-alias
      android:name=".TvLauncherActivity"
      android:enabled="true"
      android:exported="true"
      android:label="@string/app_name"
      android:targetActivity=".tv.TvAppActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
      </intent-filter>
    </activity-alias>

    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>
  </application>

</manifest>
